# Copy to .env.local for local development. Never commit .env.local.

GEMINI_API_KEY=
# Optional: defaults to gemini-2.0-flash (e.g. gemini-1.5-flash if your project only lists 1.5)
# GEMINI_MODEL=gemini-2.0-flash
KOSIS_API_KEY=

# Optional: when using `npm run dev` (Vite only), run serverless in another terminal:
#   npx vercel dev --listen 3001
# then point the Vite dev server at it so /api/* requests reach Vercel handlers:
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001
